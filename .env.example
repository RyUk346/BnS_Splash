# TEMPLATE ONLY — copy to .env and fill in real values there.
# Never put real keys/passwords in this file: it IS committed to git.
# (.env is git-ignored; .env.example is not.)

# ── Server ───────────────────────────────────────────────────
# Port the Next.js app listens on (pm2 reads this). Pick one not used by
# other apps on the box. The VPS uses 3020; leave 3000 for local dev.
PORT=3000

# ── Google Sheets ────────────────────────────────────────────
# Apps Script web app URL (see apps-script/Code.gs for setup steps).
# Must end in /exec. Health check: open it in a browser -> {"ok":true,...}
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Must match READ_KEY inside apps-script/Code.gs (admin dashboard reads the sheet)
SHEETS_READ_KEY=

# ── UniFi ────────────────────────────────────────────────────
# "cloud" = via api.ui.com Cloud Connector Proxy (recommended, no port
#           forwarding needed). "direct" = straight to the console IP.
UNIFI_MODE=cloud

# API key from unifi.ui.com -> profile icon -> API Keys.
# Scope it to All Sites so new stores work without touching the key.
UNIFI_API_KEY=

# Your console(s) — ONE PER LINE, format: consoleId|Store Label
# The label appears in the Sheet's Branch column and the admin sidebar.
# Adding a store = add another numbered line + restart. No code change.
# Any numbering works and gaps are fine (_1, _2, _7 ...).
#
# Find console IDs with:
#   curl -s https://api.ui.com/v1/hosts -H "X-API-Key: YOUR_KEY"
UNIFI_CONSOLE_1=AAAA...:111|Store One
# UNIFI_CONSOLE_2=BBBB...:222|Store Two
# UNIFI_CONSOLE_3=CCCC...:333|Store Three

# Alternative: all consoles on one comma-separated line. Both forms work
# and can be mixed; duplicate console IDs are ignored.
#   UNIFI_CONSOLES=AAAA...:111|Store One,BBBB...:222|Store Two
UNIFI_CONSOLES=

# Legacy single-console form (used only if the above are empty)
UNIFI_CONSOLE_ID=

# Direct mode only: console address reachable from this VPS
# UNIFI_CONTROLLER_URL=https://your-console-public-ip

# Optional: leave blank to auto-detect the first site
UNIFI_SITE_ID=

# How long a guest stays authorized (minutes). 1440 = 24h
AUTH_MINUTES=1440

# Session poller: minutes a device must be unseen before it's logged as
# disconnected (avoids false disconnects from sleep/roaming). Default 10.
SESSION_GRACE_MINUTES=10

# ── Splash page ──────────────────────────────────────────────
# Where guests land after connecting.
NEXT_PUBLIC_REDIRECT_URL=https://burgerandsauce.com

# Serve the app under a subpath (empty = domain root).
# NOTE: NEXT_PUBLIC_* are baked in at build time — rebuild after changing.
NEXT_PUBLIC_BASE_PATH=/SplashPage/BnS

# ── Admin dashboard (<base path>/admin) ──────────────────────
# Password for the dashboard login. Use a long random string.
ADMIN_PASSWORD=
